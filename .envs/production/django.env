# Keep Django's debug mode disabled in production.
DJANGO_DEBUG=False

# Long random string used to sign sessions and cookies.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated list of hosts IBIS is allowed to serve, e.g. ibis.example.com
DJANGO_ALLOWED_HOSTS=

# Connection string for the default database, e.g. postgres://ibis:ibis-password@postgres:5432/ibis
DATABASE_URL=
