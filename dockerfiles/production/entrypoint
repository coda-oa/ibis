#!/bin/bash
set -o errexit -o pipefail -o nounset

cd /app

uv run python - <<'EOF'
import os
import time

import psycopg

start = time.time()
while True:
    try:
        psycopg.connect(os.environ["DATABASE_URL"])
        break
    except psycopg.OperationalError:
        if time.time() - start > 30:
            raise
        print("Waiting for Postgres...", flush=True)
        time.sleep(1)
EOF

# "$@" = the CMD Docker passed us (/start); exec replaces the shell so
# migrate/gunicorn run under the same PID 1
exec "$@"
